{
  "manifest_version": 3,
  "name": "ReachOut — Recruiter Outreach Drafts",
  "description": "Drafts a tailored outreach message for the LinkedIn recruiter profile or hiring post you're viewing. You review and send it yourself.",
  "version": "0.1.0",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "ReachOut" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/in/*",
        "*://*.linkedin.com/posts/*",
        "*://*.linkedin.com/feed/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage", "scripting", "sidePanel", "tabs"],
  "host_permissions": ["*://*.linkedin.com/*"]
}
